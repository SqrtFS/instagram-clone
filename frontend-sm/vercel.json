{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://instagram-clone-production-50cc.up.railway.app/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://instagram-clone-production-50cc.up.railway.app/auth/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}